<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikTok Heart Booster - Hệ Thống Tăng Tim Uy Tín</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        tiktokRed: '#fe2c55',
                        tiktokCyan: '#25f4ee',
                        darkBg: '#121214',
                        cardBg: '#18181b',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkBg text-white font-sans min-h-screen flex flex-col justify-between">

    <header class="border-b border-gray-800 bg-cardBg/50 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-brands fa-tiktok text-tiktokCyan text-2xl"></i>
                <span class="font-bold text-xl tracking-wider">TK<span class="text-tiktokRed">BOOSTER</span></span>
            </div>
            <div class="flex items-center space-x-4 text-sm">
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">
                    <i class="fa-solid fa-coins text-yellow-400 mr-1"></i> Server: <span class="text-green-400 font-semibold">Online</span>
                </span>
            </div>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-10 w-full flex-grow">
        <div class="bg-cardBg border border-gray-800 rounded-2xl p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-tiktokCyan via-tiktokRed to-purple-500"></div>

            <div class="text-center mb-6">
                <h1 class="text-2xl font-extrabold mb-1">TĂNG TIM TIKTOK MIỄN PHÍ</h1>
                <p class="text-gray-400 text-sm">Hệ thống buff tim tự động, an toàn, không cần mật khẩu.</p>
            </div>

            <form id="buffForm" class="space-y-4" onsubmit="handleBuff(event)">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Link Video TikTok</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                            <i class="fa-solid fa-link"></i>
                        </span>
                        <input type="url" id="videoLink" required
                            class="w-full bg-darkBg border border-gray-700 rounded-xl px-4 py-3 pl-10 text-sm focus:outline-none focus:border-tiktokCyan transition"
                            placeholder="https://www.tiktok.com/@user/video/...">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Chọn Số Lượng Tim</label>
                    <select id="amount" class="w-full bg-darkBg border border-gray-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-tiktokCyan transition">
                        <option value="100">100 Tim (Test)</option>
                        <option value="500">500 Tim (Khuyên dùng)</option>
                        <option value="1000">1.000 Tim</option>
                        <option value="5000">5.000 Tim (VIP)</option>
                    </select>
                </div>

                <button type="submit" id="submitBtn"
                    class="w-full bg-gradient-to-r from-tiktokRed to-pink-600 hover:from-red-600 hover:to-pink-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition duration-200 flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-bolt"></i>
                    <span>TIẾN HÀNH TĂNG TIM</span>
                </button>
            </form>

            <div id="progressBox" class="hidden mt-6 bg-darkBg border border-gray-800 rounded-xl p-4 text-center">
                <div class="flex items-center justify-center space-x-2 mb-2">
                    <div class="w-4 h-4 border-2 border-tiktokCyan border-t-transparent rounded-full animate-spin"></div>
                    <span id="statusText" class="text-sm font-medium text-tiktokCyan">Đang kết nối hệ thống API...</span>
                </div>
                <div class="w-full bg-gray-800 rounded-full h-2.5 overflow-hidden">
                    <div id="progressBar" class="bg-gradient-to-r from-tiktokCyan to-tiktokRed h-2.5 w-0 transition-all duration-300"></div>
                </div>
            </div>

            <div id="successBox" class="hidden mt-6 bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-center">
                <i class="fa-solid fa-circle-check text-green-400 text-3xl mb-2"></i>
                <h3 class="font-bold text-green-400 text-lg">Đã Gửi Yêu Cầu Thành Công!</h3>
                <p class="text-gray-300 text-xs mt-1">Hệ thống đang phân phối tim cho video của bạn. Quá trình hoàn tất trong vòng 5 - 10 phút.</p>
                <button onclick="resetForm()" class="mt-3 text-xs bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg transition">Tiếp tục buff video khác</button>
            </div>
        </div>
    </main>

    <footer class="text-center py-4 text-xs text-gray-500 border-t border-gray-800">
        &copy; 2026 TikTok Booster System. All rights reserved.
    </footer>

    <script>
        function handleBuff(event) {
            event.preventDefault();
            const link = document.getElementById('videoLink').value;
            const amount = document.getElementById('amount').value;

            if (!link.includes('tiktok.com')) {
                alert('Vui lòng nhập đúng liên kết video TikTok!');
                return;
            }

            // Ẩn form, hiện progress
            document.getElementById('buffForm').classList.add('hidden');
            const progressBox = document.getElementById('progressBox');
            progressBox.classList.remove('hidden');

            let progress = 0;
            const progressBar = document.getElementById('progressBar');
            const statusText = document.getElementById('statusText');

            const steps = [
                { percent: 20, text: 'Đang xác thực liên kết video...' },
                { percent: 50, text: 'Đang kết nối cụm máy chủ proxy...' },
                { percent: 80, text: `Đang phân phối ${amount} lượt thích...` },
                { percent: 100, text: 'Hoàn tất quá trình gửi yêu cầu!' }
            ];

            let stepIndex = 0;
            const interval = setInterval(() => {
                if (stepIndex < steps.length) {
                    progress = steps[stepIndex].percent;
                    progressBar.style.width = progress + '%';
                    statusText.innerText = steps[stepIndex].text;
                    stepIndex++;
                } else {
                    clearInterval(interval);
                    setTimeout(() => {
                        progressBox.classList.add('hidden');
                        document.getElementById('successBox').classList.remove('hidden');
                    }, 500);
                }
            }, 800);
        }

        function resetForm() {
            document.getElementById('successBox').classList.add('hidden');
            document.getElementById('buffForm').classList.remove('hidden');
            document.getElementById('videoLink').value = '';
            document.getElementById('progressBar').style.width = '0%';
        }
    </script>
</body>
</html>
